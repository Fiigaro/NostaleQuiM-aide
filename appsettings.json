    // un slot qui contient autre chose serait consomme en boucle.
    "PotionBag": "Main",
    "HpPotionSlot": 14,
    "MpPotionSlot": null,
    "PotionCooldownSeconds": 3,

    // TOUCHES : c'est desormais la seule chose qui compte quand le bot pilote le vrai
    // client. Deplace un sort dans ta barre, change une lettre ici. Plus de cast id,
    // plus de VNum, et le probleme de la SP disparait : une touche reste une touche.
