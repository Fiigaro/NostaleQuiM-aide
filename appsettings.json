      "TargetAndAttack": "space",
      "Loot": "r",
      "HpPotion": "0",
      "MpPotion": null,

      // Intervalle minimum entre deux touches. Deux pressions envoyees dans le meme
      // instant ne font pas deux pressions pour le client : il peut en fusionner ou
      // en perdre une. Augmente si des sorts semblent ignores.
      "PressDelay": "00:00:00.150"
    },

    // Combat.
    "BasicAttackCastId": 0,
    "AttackIntervalMs": 900,
    "AttackRange": 3,
    "ApproachTargetOutOfRange": true,
    "EngagementRadius": 12,

    // Deplacement.
    "TickIntervalMs": 300,
    "MaxStepDistance": 3,
    "WaypointArrivalRadius": 2,
    "WalkSpeed": 13,

    // Buffs entretenus automatiquement.
    // Le champ Time du paquet bf est en DIXIEMES de seconde. Les valeurs brutes
    // capturees le 11/09 (3000 et 1200) valent donc 300 s et 120 s, ce qui
    // correspond exactement aux durees annoncees : SP = 300 s, tatouages = 120 s.
    // Cartes 156 / 157 = buffs SP. Cartes 1627 / 1697 = tatouages.
    // Chaque buff est sur une touche. Decoche-le dans la fenetre pour l'ignorer,
    // ou mets "Enabled": false ici.
    "BuffRefreshMarginSeconds": 60,
    "Buffs": [
      { "Name": "Buff SP 1",  "Key": "5", "CardId": 156,  "DurationSeconds": 300, "CooldownSeconds": 30 },
      { "Name": "Buff SP 2",  "Key": "6", "CardId": 157,  "DurationSeconds": 300, "CooldownSeconds": 30 },
      { "Name": "Tatouage 1", "Key": "7", "CardId": 1627, "DurationSeconds": 120, "CooldownSeconds": 30 },
      { "Name": "Tatouage 2", "Key": "8", "CardId": 1697, "DurationSeconds": 120, "CooldownSeconds": 30 }
    ],

    // A ADAPTER : ta position capturee etait (107, 202) sur la carte 5.
    // Ce carre n'est qu'un point de depart : parcours ta zone de farm a la
    // main pendant une capture et releve les lignes [IN ] mv 1 111981 <x> <y>.
    "Waypoints": [
      { "X": 107, "Y": 202 },
      { "X": 117, "Y": 202 },
      { "X": 117, "Y": 212 },
      { "X": 107, "Y": 212 }
    ],

    // ENCORE INCONNU : il faut lancer des sorts d'ATTAQUE sur un monstre pendant
