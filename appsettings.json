      "TargetAndAttack": "space",
      "Loot": "r",
      "HpPotion": null,
      "MpPotion": null
    },

    // Combat.
    "BasicAttackCastId": 0,
    "AttackIntervalMs": 900,
    "AttackRange": 3,
    "ApproachTargetOutOfRange": true,
    "EngagementRadius": 12,

    // Deplacement.
    "TickIntervalMs": 300,
    "MaxStepDistance": 3,
    "WaypointArrivalRadius": 2,
    "WalkSpeed": 13,

    // Buffs entretenus automatiquement.
    // Le champ Time du paquet bf est en DIXIEMES de seconde. Les valeurs brutes
    // capturees le 11/09 (3000 et 1200) valent donc 300 s et 120 s, ce qui
    // correspond exactement aux durees annoncees : SP = 300 s, tatouages = 120 s.
    // Cartes 156 / 157 = buffs SP. Cartes 1627 / 1697 = tatouages.
    // Tant que CastId (pour un sort) ou ItemBag+ItemSlot (pour un objet) ne sont pas
    // renseignes, le buff est ignore : le bot ne devinera pas quelle touche presser.
    "BuffRefreshMarginSeconds": 60,
    "Buffs": [
      { "Name": "Buff SP 1",  "CardId": 156,  "DurationSeconds": 300, "CooldownSeconds": 30, "CastId": null },
      { "Name": "Buff SP 2",  "CardId": 157,  "DurationSeconds": 300, "CooldownSeconds": 30, "CastId": null },
