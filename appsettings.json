{
  // Configuration de NosSmoothCustomClient.
  // Modifie ce fichier et relance : aucune recompilation necessaire.
  // Valeurs pre-remplies depuis la capture du 11/09 sur NosBreak
  // (personnage [P8]TahLaMule, id 111981, carte 5).
  "Bot": {
    // Seuils en ratio : ils s'adaptent seuls a tes 29440 PV / 32001 PM max.
    "HpPotionThreshold": 0.5,
    "MpPotionThreshold": 0.3,

    // CONFIRME par la capture du 11/09 : potion de vie VNum 1242, sac Main, slot 14.
    // MpPotionSlot est null : tu n'as pas de potion de mana, donc le bot n'en
    // utilisera aucune. Ne mets un numero que si tu en ajoutes une un jour -
    // un slot qui contient autre chose serait consomme en boucle.
    "PotionBag": "Main",
    "HpPotionSlot": 14,
    "MpPotionSlot": null,
    "PotionCooldownSeconds": 3,

    // TOUCHES : c'est desormais la seule chose qui compte quand le bot pilote le vrai
    // client. Deplace un sort dans ta barre, change une lettre ici. Plus de cast id,
    // plus de VNum, et le probleme de la SP disparait : une touche reste une touche.
    "Keys": {
      "TargetAndAttack": "space",
      "Loot": "r",
      "HpPotion": "0",
      "MpPotion": null,

      // Intervalle minimum entre deux touches. Deux pressions envoyees dans le meme
      // instant ne font pas deux pressions pour le client : il peut en fusionner ou
      // en perdre une. Augmente si des sorts semblent ignores.
      "PressDelay": "00:00:00.150"
    },

    // Combat.
    "BasicAttackCastId": 0,
    "AttackIntervalMs": 900,
    "AttackRange": 3,
    "ApproachTargetOutOfRange": true,
    "EngagementRadius": 12,

    // Deplacement.
    "TickIntervalMs": 300,
    "MaxStepDistance": 3,
    "WaypointArrivalRadius": 2,
    "WalkSpeed": 13,

    // Ce que la trace de paquets montre (onglet Paquets, et --trace en console).
    // "Hide" est le bruit de fond d'une session NosTale : deplacements d'entites,
    // apparitions, rafraichissements de stats. Mets-le a "" pour voir le flux brut.
    // "Only" l'emporte sur "Hide" : des qu'il est rempli, il est seul a decider.
    // Les memes listes s'ecrivent en ligne de commande : --only "u_i guri" / --hide ""
    "PacketTrace": {
      "Only": "",
      "Hide": "mv in out cond eff st pairy rsfi fs char_sc",
      "ShowIncoming": true,
      "ShowOutgoing": true
    },

    // Envois gardes sous un nom, rejouables depuis l'onglet Paquets.
    // Kind : PacketToServer, PacketToClient, Key, Click.
    // Body : une instruction par ligne ; {i} est remplace par le numero du passage.
    // Ceci est un EXEMPLE de forme, pas une trame qui marche : releve la tienne
    // dans la trace en faisant l'action une fois a la main, puis remplace-la.
    "SendMacros": [
      // { "Name": "Exemple", "Kind": "Click", "Body": "467,460", "Repetitions": 20, "IntervalMs": 1200 }
    ],

    // Buffs entretenus automatiquement.
    // Le champ Time du paquet bf est en DIXIEMES de seconde. Les valeurs brutes
    // capturees le 11/09 (3000 et 1200) valent donc 300 s et 120 s, ce qui
    // correspond exactement aux durees annoncees : SP = 300 s, tatouages = 120 s.
    // Cartes 156 / 157 = buffs SP. Cartes 1627 / 1697 = tatouages.
    // Chaque buff est sur une touche. Decoche-le dans la fenetre pour l'ignorer,
    // ou mets "Enabled": false ici.
    "BuffRefreshMarginSeconds": 60,
    "Buffs": [
      { "Name": "Buff SP 1",  "Key": "5", "CardId": 156,  "DurationSeconds": 300, "CooldownSeconds": 30 },
      { "Name": "Buff SP 2",  "Key": "6", "CardId": 157,  "DurationSeconds": 300, "CooldownSeconds": 30 },
      { "Name": "Tatouage 1", "Key": "7", "CardId": 1627, "DurationSeconds": 120, "CooldownSeconds": 30 },
      { "Name": "Tatouage 2", "Key": "8", "CardId": 1697, "DurationSeconds": 120, "CooldownSeconds": 30 }
    ],

    // A ADAPTER : ta position capturee etait (107, 202) sur la carte 5.
    // Ce carre n'est qu'un point de depart : parcours ta zone de farm a la
    // main pendant une capture et releve les lignes [IN ] mv 1 111981 <x> <y>.
    // "mv" fait partie des en-tetes caches par defaut : pour ce releve-la,
    // lance avec --only mv, ou vide "Hide" ci-dessus.
    "Waypoints": [
      { "X": 107, "Y": 202 },
      { "X": 117, "Y": 202 },
      { "X": 117, "Y": 212 },
      { "X": 107, "Y": 212 }
    ],

    // ENCORE INCONNU : il faut lancer des sorts d'ATTAQUE sur un monstre pendant
    // une capture (les buffs ne produisent pas de su, donc ils ne revelent rien).
    // Barre confirmee avec ton SP equipe :
    //   cast 0 -> 944, 1 -> 945, 2 -> 946, 3 -> 947, 4 -> 948, 5 -> 949,
    //   cast 6 -> 950, 7 -> 951, 8 -> 952, 9 -> 953, 10 -> 954, 11 -> 697, 12 -> 704
    // Hors SP : cast 0 -> 260, 1 -> 261, 2 -> 237, 3 -> 1482, 4 -> 1483, 5 -> 697, 6 -> 704
    "Skills": [
      { "Key": "1", "Name": "Sort 1", "CooldownSeconds": 12, "CastId": 1 },
      { "Key": "2", "Name": "Sort 2", "CooldownSeconds": 8,  "CastId": 2 },
      { "Key": "3", "Name": "Sort 3", "CooldownSeconds": 4,  "CastId": 3 },
      { "Key": "4", "Name": "Sort 4", "CooldownSeconds": 3,  "CastId": 4 }
    ]
  }
}
